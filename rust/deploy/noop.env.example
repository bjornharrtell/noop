# /etc/noop/noop.env (chown root:noop, chmod 640). Values here are examples; never commit the real file.

# The machine key. Moving from Cloudflare: use the Worker's HUB_TOKEN (secrets are sealed with it).
# New install: generate one with `openssl rand -hex 32`.
HUB_TOKEN=

# Who may sign in (comma-separated).
HUB_OWNER_EMAIL=you@example.com

# Login codes by email. Without it, `noop login` on a machine shows the code.
#HUB_SMTP={"host":"smtp.example.com","port":465,"user":"noop@example.com","pass":"…","from":"Noop <noop@example.com>"}

# en, or anything else for Simplified Chinese.
HUB_LANG=en

# Web Push: reuse ~/.noop/vapid.json from the Worker setup, or `noop-server vapid-keys` once.
#HUB_VAPID_PUBLIC=
#HUB_VAPID_PRIVATE={"kty":"EC","crv":"P-256","x":"…","y":"…","d":"…"}

# Optional source-IP allow-list.
#HUB_ALLOW_IPS=203.0.113.0/24 2001:db8:1234::/48

NOOP_DB=/var/lib/noop/noop.db
NOOP_LISTEN=127.0.0.1:8799
NOOP_WEB_DIR=/var/lib/noop/web
NOOP_CLIENT_IP_HEADER=x-forwarded-for
